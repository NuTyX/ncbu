description="The popular and trusted web browser by Google (Stable Channel)"
url="https://www.google.com/chrome"

license="custom: google chrome"

packager="tnut <tnut@nutyx.org>"
maintainer="Great-OS Team, Spiky"

name=chrome
version=153.0.8010.52


run=(alsa-lib gtk3 cups xorg-libxscrnsaver xorg-libxtst nss)


PKGMK_KEEP_SOURCES="no"
source=(https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb)

package() {
  sed -i "/Exec=/i\StartupWMClass=Google-chrome" "$PKG"/usr/share/applications/google-chrome.desktop

  rm -r "$PKG"/etc/cron.daily/ "$PKG"/opt/google/chrome/cron/

  for icon in product_logo_16.png product_logo_24.png product_logo_32.png \
  product_logo_48.png product_logo_64.png product_logo_128.png product_logo_256.png
  do
     size="$(echo ${icon} | sed 's/[^0-9]//g')"
     install -m644 -D $PKG/opt/google/chrome/$icon \
     $PKG/usr/share/icons/hicolor/"${size}x${size}"/apps/google-chrome.png
  done
  rm $PKG/opt/google/chrome/product_logo_*.png
}
