description="Signal — Private Messenger for Windows, Mac, and Linux"
url="https://signal.org/"

license="custom signal.org/legal"

packager="tnut <tnut@nutyx.org>"
contributors="Sun,Fabienwang,Spiky"

name=signal-desktop
version=8.27.0

run=(gtk3 alsa-lib at-spi2-core
     cairo cups.lib dbus expat gdk-pixbuf
     glib  libxcb libxkbcommon mesa nspr nss
     pango xorg-libdrm xorg-libx11
     xorg-libxcomposite xorg-libxdamage
     xorg-libxext xorg-libxfixes xorg-libxrandr
     xorg-libxshmfence
     shared-mime-info desktop-file-utils hicolor-icon-theme)

PKGMK_IGNORE_RUNTIMELIBS="yes"
source=(https://ftp.nluug.nl/pub/os/Linux/distr/pclinuxos/apt/pclinuxos/64bit/RPMS.x86_64/$name-$version-1pclos2026.x86_64.rpm)

build() {
   cp -rf * $PKG/
}
package() {
 install -Dm644 $PKG/opt/Signal/LICENSES.chromium.html \
 $PKG/usr/share/licenses/$name/LICENSES.chromium.html
 install -Dm644 $PKG/opt/Signal/LICENSE.electron.txt \
 $PKG/usr/share/licenses/$name/LICENSE.electron.txt
 rm $PKG/opt/Signal/LICENSE*
 chmod 4755 $PKG/opt/Signal/chrome-sandbox
}
