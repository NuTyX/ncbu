description='A free and reliable P2P BitTorrent client .'
url="https://www.qbittorrent.org/"

license="GPLv2.0"

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

name=qbittorrent
version=5.3.0

run=(gtk-update-icon-cache hicolor-icon-theme desktop-file-utils shared-mime-info)

source=(https://sourceforge.net/projects/$name/files/$name-appimage/$name-$version/$name-${version}_x86_64.AppImage)

build() {
chmod +x $name-${version}_x86_64.AppImage
./$name-${version}_x86_64.AppImage --appimage-extract

mkdir -p $PKG/usr/{share,bin}
cp -a squashfs-root/usr/share/icons \
 $PKG/usr/share/icons
cp -a squashfs-root/usr/share/metainfo \
 $PKG/usr/share/metainfo
cp -a squashfs-root/usr/share/applications \
 $PKG/usr/share/applications
cp $name-${version}_x86_64.AppImage \
 $PKG/usr/bin/
ln -sv $name-${version}_x86_64.AppImage \
 $PKG/usr/bin/$name
}
